---
interface Props {
  panelId: string;
  compact?: boolean;
  label?: string;
}
const { panelId, compact = false, label = '요약' } = Astro.props;
const warningLabel = `${label} · 스포주의`;
---

<button
  type="button"
  class:list={['summary-toggle', { 'summary-toggle-compact': compact }]}
  aria-expanded="false"
  aria-controls={panelId}
  aria-label={warningLabel}
  title={warningLabel}
  data-summary-toggle
>
  <span>{label}</span>{!compact && <span class="summary-warning"> · 스포주의</span>}
</button>
