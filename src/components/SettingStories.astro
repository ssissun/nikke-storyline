---
import { settingStoryGroups } from '../data/settingStories';
import { anchorId } from '../anchors';
import { thumbnailsFor } from '../thumbnails';
import Thumb from './Thumb.astro';
---

<section class="notes setting-stories">
  <h2>놓치기 쉬운 니케 주요 설정 관련 스토리 모음</h2>
  <p class="bonus-lead">
    필수가 아니라서 지나치기 쉽지만, 니케 세계관의 주요 설정을 다루는 스토리들
  </p>
  <div class="notes-grid">
    {
      settingStoryGroups.map((group) => (
        <div class="note" id={anchorId('setting', group.setting)}>
          <span class="tag">{group.setting}</span>
          <div class="body">
            <ul class="bonus-list">
              {group.events.map((event) => (
                <li class:list={{ 'has-mini': thumbnailsFor(event).length > 0 }}>
                  <Thumb title={event} size="mini" />
                  <strong>{event}</strong>
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))
    }
  </div>
</section>
