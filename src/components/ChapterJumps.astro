---
// 챕터 바로가기. 25부터 5의 배수마다, 그 챕터가 들어 있는 메인 카드(OLD TALES 묶음 포함)로 이동한다.
// 버튼은 한 줄만 허용하며 공간이 부족하면 10의 배수로 축소한 뒤 메뉴로 전환한다.
import { timeline } from '../data/timeline';
import { anchorId } from '../anchors';
import walkIcon from '@tabler/icons/outline/walk.svg?raw';

const FIRST_CHAPTER = 25;
const STEP = 5;
const TEN_FROM = 30; // ten 모드에서 남기는 첫 챕터

const mainRanges = timeline.flatMap((entry) => {
  if (entry.type === 'divider') return [];
  const range = entry.title.match(/^Chapter (\d+)\s*—\s*(\d+)/);
  return range ? [{ from: Number(range[1]), to: Number(range[2]), id: anchorId('story', entry.title) }] : [];
});
const lastChapter = Math.max(0, ...mainRanges.map(({ to }) => to));

const jumps = Array.from({ length: Math.max(0, Math.floor((lastChapter - FIRST_CHAPTER) / STEP) + 1) }, (_, i) => {
  const chapter = FIRST_CHAPTER + i * STEP;
  const card = mainRanges.find(({ from, to }) => from <= chapter && chapter <= to);
  return card ? [{ chapter, id: card.id, ten: chapter >= TEN_FROM && chapter % 10 === 0 }] : [];
}).flat();
---

{
  jumps.length > 0 && (
    <nav class="tf-jumps" aria-label="챕터 바로가기" data-chapter-jumps data-mode="five">
      <span class="tf-jumps-label">챕터 바로가기</span>
      <div class="tf-jumps-row">
      <span class="tf-jumps-hint" aria-hidden="true" set:html={walkIcon} />
      <button
        class="tf-jumps-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="chapter-jump-list"
        aria-label="챕터 바로가기 펼치기"
        data-chapter-jumps-toggle
      >
        <span class="tf-jumps-menu-label">챕터 바로가기</span><span aria-hidden="true">▾</span>
      </button>
      <div class="tf-jump-list" id="chapter-jump-list" data-chapter-jump-list>
        {jumps.map(({ chapter, id, ten }) => (
          <a class="tf-jump" href={`#${id}`} data-jump={id} data-ten={ten ? '' : undefined}>
            {chapter}
          </a>
        ))}
      </div>
      </div>
    </nav>
  )
}

<script>
  import { jumpTo } from '../jump';
  import { track } from '../track';

  const MAX_BUTTON_LINES = 1;
  const nav = document.querySelector<HTMLElement>('[data-chapter-jumps]');
  const rows = [...(nav?.querySelectorAll<HTMLElement>('.tf-jumps-row') ?? [])];
  const section = nav?.closest<HTMLElement>('[data-timeline-section]');

  // 보이는 항목이 몇 줄에 걸쳐 있는지. 라벨과 버튼은 높이가 달라 위치가 몇 px 어긋나므로
  // 앞 줄의 아래 끝보다 아래에서 시작하는 것만 새 줄로 센다.
  const lineCount = (row: HTMLElement) => {
    const rects = [...row.querySelectorAll<HTMLElement>('.tf-jumps-hint, .tf-jump')]
      .filter((item) => item.offsetParent !== null)
      .map((item) => item.getBoundingClientRect())
      .toSorted((a, b) => a.top - b.top);
    let lines = 0;
    let lineBottom = -Infinity;
    for (const rect of rects) {
      if (rect.top >= lineBottom - 1) {
        lines += 1;
        lineBottom = rect.bottom;
      } else {
        lineBottom = Math.max(lineBottom, rect.bottom);
      }
    }
    return lines;
  };

  const setOpen = (selected?: HTMLElement) => {
    rows.forEach((row) => {
      const open = row === selected;
      row.classList.toggle('is-open', open);
      row.querySelector('[data-chapter-jumps-toggle]')?.setAttribute('aria-expanded', String(open));
    });
  };

  const LAYOUTS = [
    'five',
    'ten',
  ];

  const layout = () => {
    if (!nav) return;
    setOpen();
    for (const mode of LAYOUTS) {
      nav.dataset.mode = mode;
      const fits = rows.every((row) => lineCount(row) <= MAX_BUTTON_LINES);
      if (fits) return;
    }
    nav.dataset.mode = 'menu';
  };

  nav?.addEventListener('click', (event) => {
    const toggle = (event.target as Element).closest('[data-chapter-jumps-toggle]');
    if (toggle) {
      const row = toggle.closest<HTMLElement>('.tf-jumps-row');
      setOpen(row && !row.classList.contains('is-open') ? row : undefined);
      return;
    }
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-jump]');
    if (!link) return;
    event.preventDefault();
    setOpen();
    track('jump', { via: 'chapter', card: link.dataset.jump ?? '' });
    jumpTo(link.dataset.jump ?? '');
  });
  document.addEventListener('click', (event) => {
    if (!nav?.contains(event.target as Node)) setOpen();
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      rows.find((row) => row.classList.contains('is-open'))?.querySelector<HTMLButtonElement>('button')?.focus();
      setOpen();
    }
  });

  let resizeFrame = 0;
  const scheduleLayout = () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(layout);
  };
  window.addEventListener('resize', scheduleLayout);
  // 고정 중 라벨을 숨겨도 첫 카드가 위로 당겨지지 않도록 원래 높이를 유지한다.
  let observedWidth = -1;
  if (nav) {
    new ResizeObserver(() => {
      const rect = nav.getBoundingClientRect();
      document.documentElement.style.setProperty('--chapter-bar-height', `${rect.height}px`);
      if (!nav.hasAttribute('data-stuck')) {
        section?.style.setProperty('--chapter-nav-height', `${Math.ceil(rect.height)}px`);
      }
      if (Math.abs(rect.width - observedWidth) > 0.5) {
        observedWidth = rect.width;
        scheduleLayout();
      }
    }).observe(nav);
  }
  document.fonts.ready.then(scheduleLayout);
  const updatePosition = () => {
    if (!nav || !section) return;
    const top = parseFloat(getComputedStyle(nav).top) || 0;
    nav.style.setProperty('--chapter-edge-inset', `${section.getBoundingClientRect().left}px`);
    const stuck = section.getBoundingClientRect().top < top;
    if (nav.hasAttribute('data-stuck') !== stuck) {
      nav.toggleAttribute('data-stuck', stuck);
      layout();
    }
    nav.style.setProperty('--chapter-bar-left', `${nav.getBoundingClientRect().left}px`);
    nav.style.setProperty('--chapter-bar-width', `${document.documentElement.clientWidth}px`);
    const rect = nav.getBoundingClientRect();
    document.documentElement.toggleAttribute('data-chapter-bar-stuck', stuck && rect.top >= -1);
    document.documentElement.style.setProperty('--chapter-bar-height', `${rect.height}px`);
  };
  let positionFrame = 0;
  const schedulePosition = () => {
    cancelAnimationFrame(positionFrame);
    positionFrame = requestAnimationFrame(updatePosition);
  };
  window.addEventListener('scroll', schedulePosition, { passive: true });
  window.addEventListener('resize', schedulePosition);
  document.addEventListener('timeline:filtered', schedulePosition);
  layout();
  updatePosition();
</script>
