---
// 챕터 바로가기. 25부터 5의 배수마다, 그 챕터가 들어 있는 메인 카드(OLD TALES 묶음 포함)로 이동한다.
// 메인 카드가 늘면 버튼도 저절로 늘어난다. 한 줄에 다 안 들어가면 아래 순서로 맞춘다
// (버튼은 최대 두 줄, 라벨 줄은 따로 세지 않으므로 전체는 최대 세 줄):
//   1) 5의 배수 전부를 라벨과 한 줄에        2) 라벨만 윗줄로 내리고 버튼은 두 줄까지
//   3) 30부터 10의 배수만 라벨과 한 줄에     4) 10의 배수만, 라벨은 윗줄 · 버튼은 두 줄까지
//   5) 그래도 안 되면 '챕터 바로가기' 버튼 하나로 접고, 누르면 5의 배수 전부를 펼친다
import { timeline } from '../data/timeline';
import { anchorId } from '../anchors';

const FIRST_CHAPTER = 25;
const STEP = 5;
const TEN_FROM = 30; // ten 모드에서 남기는 첫 챕터

const mainRanges = timeline.flatMap((entry) => {
  if (entry.type === 'divider') return [];
  const range = entry.title.match(/^Chapter (\d+)\s*—\s*(\d+)/);
  return range ? [{ from: Number(range[1]), to: Number(range[2]), id: anchorId('story', entry.title) }] : [];
});
const lastChapter = Math.max(0, ...mainRanges.map(({ to }) => to));

const jumps = Array.from({ length: Math.max(0, Math.floor((lastChapter - FIRST_CHAPTER) / STEP) + 1) }, (_, i) => {
  const chapter = FIRST_CHAPTER + i * STEP;
  const card = mainRanges.find(({ from, to }) => from <= chapter && chapter <= to);
  return card ? [{ chapter, id: card.id, ten: chapter >= TEN_FROM && chapter % 10 === 0 }] : [];
}).flat();
---

{
  jumps.length > 0 && (
    <nav class="tf-jumps" aria-label="챕터 바로가기" data-chapter-jumps data-mode="five">
      <span class="tf-jumps-label">챕터 바로가기</span>
      <button
        class="tf-jumps-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="chapter-jump-list"
        data-chapter-jumps-toggle
      >
        챕터 바로가기 <span aria-hidden="true">▾</span>
      </button>
      <div class="tf-jump-list" id="chapter-jump-list" data-chapter-jump-list>
        {jumps.map(({ chapter, id, ten }) => (
          <a class="tf-jump" href={`#${id}`} data-jump={id} data-ten={ten ? '' : undefined}>
            {chapter}
          </a>
        ))}
      </div>
    </nav>
  )
}

<script>
  import { jumpTo } from '../jump';
  import { track } from '../track';

  const MAX_BUTTON_LINES = 2;
  const nav = document.querySelector<HTMLElement>('[data-chapter-jumps]');
  const list = document.querySelector<HTMLElement>('[data-chapter-jump-list]');
  const toggle = document.querySelector<HTMLButtonElement>('[data-chapter-jumps-toggle]');

  // 보이는 항목이 몇 줄에 걸쳐 있는지. 라벨과 버튼은 높이가 달라 위치가 몇 px 어긋나므로
  // 앞 줄의 아래 끝보다 아래에서 시작하는 것만 새 줄로 센다.
  const lineCount = (selector: string) => {
    if (!nav) return 0;
    const rects = [...nav.querySelectorAll<HTMLElement>(selector)]
      .filter((item) => item.offsetParent !== null)
      .map((item) => item.getBoundingClientRect())
      .toSorted((a, b) => a.top - b.top);
    let lines = 0;
    let lineBottom = -Infinity;
    for (const rect of rects) {
      if (rect.top >= lineBottom - 1) {
        lines += 1;
        lineBottom = rect.bottom;
      } else {
        lineBottom = Math.max(lineBottom, rect.bottom);
      }
    }
    return lines;
  };

  const setOpen = (open: boolean) => {
    toggle?.setAttribute('aria-expanded', String(open));
    nav?.classList.toggle('is-open', open);
  };

  const LAYOUTS = [
    { mode: 'five', labelBreak: false },
    { mode: 'five', labelBreak: true },
    { mode: 'ten', labelBreak: false },
    { mode: 'ten', labelBreak: true },
  ];

  const layout = () => {
    if (!nav) return;
    setOpen(false);
    for (const { mode, labelBreak } of LAYOUTS) {
      nav.dataset.mode = mode;
      nav.toggleAttribute('data-label-break', labelBreak);
      // 라벨을 내리지 않으면 라벨까지 한 줄, 내리면 버튼만 두 줄까지
      const fits = labelBreak
        ? lineCount('.tf-jump') <= MAX_BUTTON_LINES
        : lineCount('.tf-jumps-label, .tf-jump') === 1;
      if (fits) return;
    }
    nav.toggleAttribute('data-label-break', false);
    nav.dataset.mode = 'menu';
  };

  list?.addEventListener('click', (event) => {
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-jump]');
    if (!link) return;
    event.preventDefault();
    setOpen(false);
    track('jump', { via: 'chapter', card: link.dataset.jump ?? '' });
    jumpTo(link.dataset.jump ?? '');
  });
  toggle?.addEventListener('click', () => setOpen(!nav?.classList.contains('is-open')));
  document.addEventListener('click', (event) => {
    if (nav?.classList.contains('is-open') && !nav.contains(event.target as Node)) setOpen(false);
  });
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && nav?.classList.contains('is-open')) setOpen(false);
  });

  let resizeFrame = 0;
  window.addEventListener('resize', () => {
    cancelAnimationFrame(resizeFrame);
    resizeFrame = requestAnimationFrame(layout);
  });
  layout();
</script>
