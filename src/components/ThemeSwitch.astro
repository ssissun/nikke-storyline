---
// 다크/라이트 토글 스위치. localStorage에 nikke-theme 저장.
---

<button
  class="theme-switch"
  type="button"
  role="switch"
  aria-label="테마 전환"
  data-theme-switch
>
  <span class="theme-switch-track">
    <span class="theme-switch-icon sun" aria-hidden="true">☀</span>
    <span class="theme-switch-icon moon" aria-hidden="true">☾</span>
    <span class="theme-switch-knob"></span>
  </span>
</button>

<script>
  const buttons = document.querySelectorAll('[data-theme-switch]');
  const sync = () => buttons.forEach((btn) => btn.setAttribute('aria-checked', String(document.documentElement.dataset.theme === 'dark')));
  buttons.forEach((btn) => btn.addEventListener('click', () => {
    const html = document.documentElement;
    const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    html.setAttribute('data-theme', next);
    sync();
    localStorage.setItem('nikke-theme', next);
  }));
  sync();
</script>
