---
import type { StoryCard } from '../data/types';
import { laneFor } from '../data/types';
import Stars from './Stars.astro';
import { anchorId } from '../anchors';
import { cardFilterAttrs } from '../timelineFilter';
import { thumbnailsFor } from '../thumbnails';
import Thumb from './Thumb.astro';
import WatchToggle from './WatchToggle.astro';
import SummaryToggle from './SummaryToggle.astro';
import StorySummary from './StorySummary.astro';

interface Props {
  card: StoryCard;
  order: number; // 1-indexed
}

const { card, order } = Astro.props;

const lane = laneFor(card.category);
const dataReq = card.required ? 'req' : 'opt';
const orderStr = String(order).padStart(2, '0');
const ttlClass = card.titleScript === 'kor' ? 'ttl kor' : 'ttl';
const thumbs = thumbnailsFor(card.title, card.storyTitles);
const id = card.id ?? anchorId('story', card.title);
const annotations = card.annotations ?? [];
const expandedAnnotations = card.expandedAnnotations ?? [];
const storySummary = card.summary;
const summaryId = `${id}-summary`;

const categoryLabel: Record<StoryCard['category'], string> = {
  main: '메인',
  event: '이벤트',
  side: '사이드',
  affinity: '인연스',
};
---

<div
  class="node"
  data-cat={card.category}
  data-req={dataReq}
  data-side={lane}
  {...cardFilterAttrs(card)}
>
  {lane === 'right' && <div class="marker"><div class="dot"></div></div>}

  <div
    class:list={['card', lane, { 'has-thumb': thumbs.length > 0, 'has-story-group': Boolean(card.storyTitles?.length) }]}
    id={id}
    data-cat={card.category}
    data-req={dataReq}
    data-anniv={card.anniversary ? '' : undefined}
  >
    <Thumb title={card.title} storyTitles={card.storyTitles} />
    <WatchToggle id={id} title={card.title} />
    <div class="head">
      <span class="order">{orderStr}</span>
      <span class={ttlClass}>{card.title}</span>
    </div>
    <div class:list={['meta-row', { 'has-summary-action': Boolean(storySummary) }]}>
      <span class={`badge cat-${card.category}`}>{categoryLabel[card.category]}</span>
      {card.anniversary && <span class="badge anniv">{card.anniversary}</span>}
      {card.noDub && <span class="badge no-dub">더빙X</span>}
      <span class={`badge ${card.required ? 'req' : 'opt'}`}>
        {card.required ? '필수' : '선택'}
      </span>
      {card.important && <span class="badge important">중요</span>}
      <Stars required={card.required} importance={card.importance} />
      {storySummary && <SummaryToggle panelId={summaryId} compact />}
    </div>
    {
      (annotations.length > 0 || expandedAnnotations.length > 0) && (
        <div class="annot">
          {annotations.length > 0 && (
            <ul>
              {annotations.map((a) => <li set:html={a} />)}
            </ul>
          )}
          {expandedAnnotations.length > 0 && (
            <details class="card-details">
              <summary>참고</summary>
              <ul>
                {expandedAnnotations.map((a) => <li set:html={a} />)}
              </ul>
            </details>
          )}
        </div>
      )
    }
    {storySummary && <StorySummary id={summaryId} paragraphs={storySummary} />}
  </div>

  {lane === 'left' && <div class="marker"><div class="dot"></div></div>}
</div>
