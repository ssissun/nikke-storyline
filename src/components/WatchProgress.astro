---
// 감상 진행률. 카드의 체크(WatchToggle)를 모아 'N / 전체'와 막대로 보여 주고(메인은 챕터 수만큼 센다),
// '이어서 보기'는 지금 필터로 보이는 카드만 기준으로, 본 카드 중 가장 뒤의 다음 카드로 이동한다.
// 단 그보다 앞에 안 본 필수 카드가 있으면 그중 가장 앞의 것으로 간다(필수는 건너뛰지 않게, 선택은 건너뛰어도 되게).
// 필터는 풀지 않는다. 기록은 src/watched.ts.
---

<div class="watch-progress" data-watch-progress>
  <span class="watch-progress-label">감상 진행</span>
  <span class="watch-progress-bar" aria-hidden="true"><span data-watch-bar></span></span>
  <span class="watch-progress-count" aria-live="polite" data-watch-count></span>
  <button class="watch-progress-action is-primary" type="button" data-watch-continue>이어서 보기</button>
  <button class="watch-progress-action" type="button" hidden data-watch-reset>기록 지우기</button>
</div>

<script>
  import { loadWatched, saveWatched, TIMELINE_FILTERED, WATCHED_CHANGE } from '../watched';
  import { jumpTo } from '../jump';

  const REQUIRED_RANK = 3; // timelineFilter.ts의 data-rank: 필수

  const watched = loadWatched();
  const toggles = [...document.querySelectorAll<HTMLButtonElement>('[data-watch]')];
  const bar = document.querySelector<HTMLElement>('[data-watch-bar]');
  const count = document.querySelector('[data-watch-count]');
  const continueButton = document.querySelector<HTMLButtonElement>('[data-watch-continue]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-watch-reset]');

  // 체크 표시는 버튼에, 흐리게 보이기 · 필터용 표시는 스토리라인 항목(.node)에 단다
  const render = () => {
    for (const toggle of toggles) {
      const isWatched = watched.has(toggle.dataset.watch ?? '');
      toggle.setAttribute('aria-pressed', String(isWatched));
      toggle.closest('[data-filter-item]')?.toggleAttribute('data-watched', isWatched);
    }
    const weightOf = (toggle: HTMLElement) => Number(toggle.dataset.weight ?? 1);
    const done = toggles
      .filter((toggle) => watched.has(toggle.dataset.watch ?? ''))
      .reduce((sum, toggle) => sum + weightOf(toggle), 0);
    const total = toggles.reduce((sum, toggle) => sum + weightOf(toggle), 0);
    const percent = total ? Math.round((done / total) * 100) : 0;
    if (bar) bar.style.width = `${percent}%`;
    if (count) count.textContent = `${done} / ${total} · ${percent}%`;
    if (resetButton) resetButton.hidden = done === 0;
    document.dispatchEvent(new CustomEvent(WATCHED_CHANGE)); // 필터가 다시 계산되면 이어서 보기도 갱신된다
  };

  const isWatched = (toggle: HTMLElement) => watched.has(toggle.dataset.watch ?? '');

  // 이어서 볼 카드(필터로 보이는 카드 중). 없으면 undefined
  const continueTarget = () => {
    const visible = toggles.filter((toggle) => !toggle.closest('[hidden]'));
    const lastWatched = visible.findLastIndex(isWatched);
    const skippedRequired = visible.find(
      (toggle, index) =>
        index < lastWatched &&
        !isWatched(toggle) &&
        Number(toggle.closest<HTMLElement>('[data-filter-item]')?.dataset.rank) === REQUIRED_RANK,
    );
    return { target: skippedRequired ?? visible[lastWatched + 1], started: lastWatched >= 0 };
  };

  const updateContinue = () => {
    if (!continueButton) return;
    const { target, started } = continueTarget();
    continueButton.hidden = !target;
    continueButton.textContent = started ? '이어서 보기' : '처음부터 보기';
  };

  document.addEventListener('click', (event) => {
    const toggle = (event.target as Element).closest<HTMLButtonElement>('[data-watch]');
    if (!toggle) return;
    const id = toggle.dataset.watch ?? '';
    if (watched.has(id)) watched.delete(id);
    else watched.add(id);
    saveWatched(watched);
    render();
  });

  continueButton?.addEventListener('click', () => {
    const { target } = continueTarget();
    if (target?.dataset.watch) jumpTo(target.dataset.watch); // 보이는 카드라 필터는 그대로 둔다
  });
  document.addEventListener(TIMELINE_FILTERED, updateContinue);

  resetButton?.addEventListener('click', () => {
    if (!window.confirm('감상 기록을 모두 지울까요?')) return;
    watched.clear();
    saveWatched(watched);
    render();
  });

  render();
  updateContinue();
</script>
