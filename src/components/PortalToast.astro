---
// NIKKE Portal 안내. 직접 들어온 방문자에게 잠시 뒤 아래쪽에 띄운다.
// Portal 화면 안(iframe)에서 열렸으면 띄우지 않는다. '다시 보지 않기'나 링크를 누르면 이 브라우저에선 다시 안 띄운다.
// 같은 주소(ssissun.github.io) 아래 레이드 싱크와 저장 공간을 같이 쓰므로 키에 사이트 이름을 붙여 따로 기억한다.
// 두 버튼을 누른 횟수는 Umami 이벤트 portal-toast(action: open | never)로 센다.
const PORTAL_URL = 'https://ssissun.github.io/nikke-portal/#story-ssissun';
---

<aside class="portal-toast" role="status" aria-label="NIKKE Portal 안내" hidden data-portal-toast>
  <p class="portal-toast-text">
    이 페이지는 <b>NIKKE Portal</b>에서도 볼 수 있어요. 이 외에도 니케 관련 유용한 사이트들을 한 화면에서 모아볼 수 있어요.
  </p>
  <div class="portal-toast-actions">
    <a class="portal-toast-action is-primary" href={PORTAL_URL} target="_blank" rel="noopener" data-portal-toast-open>
      Portal 열기
    </a>
    <button class="portal-toast-action" type="button" data-portal-toast-never>다시 보지 않기</button>
    <button class="portal-toast-close" type="button" aria-label="닫기" data-portal-toast-close>×</button>
  </div>
</aside>

<script>
  const STORAGE_KEY = 'nikke-portal-toast:storyline';
  const SHOW_DELAY_MS = 3000;

  import { track } from '../track';

  const toast = document.querySelector<HTMLElement>('[data-portal-toast]');

  const dismissed = () => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'dismissed';
    } catch {
      return false;
    }
  };
  const dismissForever = () => {
    try {
      localStorage.setItem(STORAGE_KEY, 'dismissed');
    } catch {
      // 저장 실패는 무시한다 (이번 방문에서만 닫힌다)
    }
  };
  const hide = () => {
    if (toast) toast.hidden = true;
  };

  if (toast && window.self === window.top && !dismissed()) {
    setTimeout(() => (toast.hidden = false), SHOW_DELAY_MS);
    toast.querySelector('[data-portal-toast-close]')?.addEventListener('click', hide);
    toast.querySelector('[data-portal-toast-never]')?.addEventListener('click', () => {
      track('portal-toast', { action: 'never' });
      dismissForever();
      hide();
    });
    toast.querySelector('[data-portal-toast-open]')?.addEventListener('click', () => {
      track('portal-toast', { action: 'open' });
      dismissForever();
      hide();
    });
  }
</script>
