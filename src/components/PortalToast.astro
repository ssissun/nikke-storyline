---
// NIKKE Portal 안내. 직접 들어온 방문자가 타임라인 25% 지점까지 내려오면 아래쪽에 띄운다.
// Portal 화면 안(iframe)에서 열렸으면 띄우지 않는다. '다시 보지 않기'나 링크를 누르면 이 브라우저에선 다시 안 띄운다.
// 같은 주소(ssissun.github.io) 아래 레이드 싱크와 저장 공간을 같이 쓰므로 키에 사이트 이름을 붙여 따로 기억한다.
// 버튼을 누른 횟수는 Umami 이벤트 portal-toast(action: open | never | close)로 센다.
const PORTAL_URL = 'https://ssissun.github.io/nikke-portal/#story-ssissun';
---

<aside class="portal-toast" role="status" aria-label="NIKKE Portal 안내" hidden data-portal-toast>
  <p class="portal-toast-text">
    이 사이트를 포함한 유용한 사이트를 한 사이트에서 한 눈에!
  </p>
  <div class="portal-toast-actions">
    <a class="portal-toast-action is-primary" href={PORTAL_URL} target="_blank" rel="noopener" data-portal-toast-open>
      Portal 열기
    </a>
    <button class="portal-toast-action" type="button" data-portal-toast-never>다시 보지 않기</button>
    <button class="portal-toast-close" type="button" aria-label="닫기" data-portal-toast-close>×</button>
  </div>
</aside>

<script>
  import { track } from '../track';

  const STORAGE_KEY = 'nikke-portal-toast:storyline';
  // Portal은 홈 방문만 해도 last를 저장한다. 값의 내용은 읽지 않고 기록 유무만 확인한다.
  const PORTAL_HISTORY_KEYS = ['nikke-hub:last', 'nikke-hub:recent', 'nikke-hub:favorites', 'nikke-hub:custom'];
  const SHOW_AT_RATIO = 0.25; // 타임라인 25% 지점 (Analytics.astro의 reach '타임라인 25%'와 같은 카드)

  const toast = document.querySelector<HTMLElement>('[data-portal-toast]');
  const timelineNodes = document.querySelectorAll<HTMLElement>('.timeline .node');
  const showPoint = timelineNodes[Math.floor(timelineNodes.length * SHOW_AT_RATIO)];

  const hasPortalHistory = () => {
    try {
      return PORTAL_HISTORY_KEYS.some((key) => localStorage.getItem(key) !== null);
    } catch {
      return false;
    }
  };
  const dismissed = () => {
    try {
      return localStorage.getItem(STORAGE_KEY) === 'dismissed' || hasPortalHistory();
    } catch {
      return false;
    }
  };
  const dismissForever = () => {
    try {
      localStorage.setItem(STORAGE_KEY, 'dismissed');
    } catch {
      // 저장 실패는 무시한다 (이번 방문에서만 닫힌다)
    }
  };
  const hide = () => {
    if (toast) toast.hidden = true;
    window.removeEventListener('scroll', showIfReached);
  };
  const showIfReached = () => {
    if (dismissed()) {
      hide();
      return;
    }
    if (!toast || !showPoint || showPoint.getBoundingClientRect().top >= window.innerHeight) return;
    toast.hidden = false;
    window.removeEventListener('scroll', showIfReached);
  };
  if (hasPortalHistory()) dismissForever();
  window.addEventListener('storage', (event) => {
    if (event.key === STORAGE_KEY || (event.key && PORTAL_HISTORY_KEYS.includes(event.key))) {
      if (hasPortalHistory()) dismissForever();
      if (dismissed()) hide();
    }
  });

  if (toast && showPoint && window.self === window.top && !dismissed()) {
    // 그 지점이 화면에 들어왔거나 이미 지나쳤으면(바로가기로 건너뛴 경우 포함) 띄운다.
    window.addEventListener('scroll', showIfReached, { passive: true });
    showIfReached();
    toast.querySelector('[data-portal-toast-close]')?.addEventListener('click', () => {
      track('portal-toast', { action: 'close' });
      hide();
    });
    toast.querySelector('[data-portal-toast-never]')?.addEventListener('click', () => {
      track('portal-toast', { action: 'never' });
      dismissForever();
      hide();
    });
    toast.querySelector('[data-portal-toast-open]')?.addEventListener('click', () => {
      track('portal-toast', { action: 'open' });
      dismissForever();
      hide();
    });
  }
</script>
