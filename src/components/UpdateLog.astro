---
// Masthead 아래 최신 업데이트 한 줄. 누르면 최근 업데이트 로그 창이 열린다.
// 로그의 줄이 특정 카드를 가리키면(to) 누를 때 창을 닫고 그 위치로 이동한다.
// 같은 날짜 안에서는 스토리라인 안 → 그 밖의 스토리(스토리라인 밖 · 설정 스토리 · 호평 이벤트 등) → 사이트 변경 순으로,
// 각 묶음 안에서는 위치로 이동할 수 있는 줄을 먼저 보여 준다.
// 그래서 상단 한 줄은 가능한 한 '바로가기'가 되는 최근 스토리라인 변경이다.
import { updates } from '../data/updates';
import { timeline } from '../data/timeline';
import { bonusCards } from '../data/bonus';
import { externalNotes } from '../data/notes';
import { settingStoryGroups } from '../data/settingStories';
import type { UpdateLogItem } from '../data/types';
import { anchorId } from '../anchors';

const RECENT_COUNT = 10; // 창에 보여줄 최근 업데이트 날짜 수

// 분류 꼬리표 색은 카드 카테고리 색을 따른다. 섹션 · 기능 등 꼬리표는 기본색.
const TAG_CATEGORY: Record<string, string> = {
  메인: 'main',
  이벤트: 'event',
  사이드: 'side',
  '인연 스토리': 'affinity',
};

// 제목 → 요소 id. 이름이 바뀌거나 지워진 카드를 가리키면 링크 없이 보여 준다.
const targets = new Map<string, string>();
const register = (kind: Parameters<typeof anchorId>[0], title: string) => {
  if (!targets.has(title)) targets.set(title, anchorId(kind, title));
};
timeline.forEach((item) => item.type !== 'divider' && register('story', item.title));
bonusCards.forEach((card) => register('bonus', card.title));
externalNotes.forEach((note) => register('note', note.title));
settingStoryGroups.forEach((group) => register('setting', group.setting));

const parseItem = (item: UpdateLogItem) => {
  const line = typeof item === 'string' ? item : item.text;
  const to = typeof item === 'string' ? undefined : item.to;
  const target = to ? targets.get(to) : undefined;
  if (to && !target) console.warn(`[update-log] 이동할 위치를 찾지 못함: ${to}`);
  const match = line.match(/^\[([^\]]+)\]\s*(.*)$/);
  return {
    tag: match ? match[1] : '',
    text: match ? match[2] : line,
    target,
  };
};

// 스토리라인(타임라인) 안의 카드 · 묶음에 대한 줄, 그리고 스토리 내용이 아닌 사이트 자체의 변경
const STORYLINE_TAGS = new Set(['메인', '이벤트', '사이드', '인연 스토리', '타임라인']);
const SITE_TAGS = new Set(['기능', '디자인']);
type Line = ReturnType<typeof parseItem>;
const group = (line: Line) => (STORYLINE_TAGS.has(line.tag) ? 0 : SITE_TAGS.has(line.tag) ? 2 : 1);
const rank = (line: Line) => group(line) * 2 + (line.target ? 0 : 1);
const sortLines = (lines: Line[]) => lines.toSorted((a, b) => rank(a) - rank(b)); // 같은 순위는 원래 순서 유지

const formatDate = (date: string) => date.replaceAll('-', '.');

const recent = updates.slice(0, RECENT_COUNT).map(({ date, items }) => ({
  date,
  lines: sortLines(items.map(parseItem)),
}));
const [latest] = recent;
const [headline] = latest.lines;
const moreCount = latest.lines.length - 1;
---

<div class="update-line">
  <button class="update-line-main" type="button" aria-haspopup="dialog" data-update-open>
    <span class="update-line-label">업데이트</span>
    <span class="update-line-text">
      {headline.tag && <span class={`update-tag ${TAG_CATEGORY[headline.tag] ?? ''}`}>[{headline.tag}]</span>}
      {headline.text}
      {moreCount > 0 && <span class="update-line-more">외 {moreCount}건</span>}
    </span>
  </button>
  {
    headline.target && (
      <a class="update-line-action" href={`#${headline.target}`} data-jump={headline.target}>
        바로가기
      </a>
    )
  }
  <button class="update-line-action update-line-open" type="button" aria-haspopup="dialog" data-update-open>
    전체 보기
  </button>
</div>

<dialog class="update-log motion-dialog" aria-labelledby="update-log-title" data-update-log>
  <div class="update-log-head">
    <h2 id="update-log-title">업데이트 로그</h2>
    <button class="update-log-close" type="button" aria-label="닫기" data-dialog-close>×</button>
  </div>
  <div class="update-log-body">
    {
      recent.map(({ date, lines }) => (
        <section class="update-day">
          <time class="update-day-date" datetime={date}>{formatDate(date)}</time>
          <ul>
            {lines.map(({ tag, text, target }) => {
              const tagEl = tag && (
                <span class={`update-tag ${TAG_CATEGORY[tag] ?? ''}`}>[{tag}]</span>
              );
              return (
                <li>
                  {target ? (
                    <a class="update-jump" href={`#${target}`} data-jump={target}>
                      {tagEl} {text}
                    </a>
                  ) : (
                    <>{tagEl}{' '}{text}</>
                  )}
                </li>
              );
            })}
          </ul>
        </section>
      ))
    }
  </div>
</dialog>

<script>
  import { bindDialogMotion, closeDialog } from '../dialogMotion';
  import { jumpTo } from '../jump';

  const dialog = document.querySelector<HTMLDialogElement>('[data-update-log]');

  if (dialog) bindDialogMotion(dialog);
  document.querySelectorAll('[data-update-open]').forEach((button) =>
    button.addEventListener('click', () => {
      dialog?.classList.remove('is-closing');
      dialog?.showModal();
    }),
  );
  // 상단 한 줄의 바로가기
  document.querySelector<HTMLAnchorElement>('.update-line [data-jump]')?.addEventListener('click', (event) => {
    event.preventDefault();
    jumpTo((event.currentTarget as HTMLAnchorElement).dataset.jump ?? '');
  });

  dialog?.addEventListener('click', async (event) => {
    // 창 바깥(backdrop)을 누르면 닫는다
    if (event.target === dialog) {
      closeDialog(dialog);
      return;
    }
    const link = (event.target as Element).closest<HTMLAnchorElement>('[data-jump]');
    if (!link) return;

    event.preventDefault();
    await closeDialog(dialog); // 닫힌 뒤 포커스가 되돌아간 다음에 이동해야 스크롤이 튀지 않는다
    jumpTo(link.dataset.jump ?? '');
  });
</script>
