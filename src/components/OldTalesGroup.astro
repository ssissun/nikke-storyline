---
import type { OldTalesGroup } from '../data/types';
import { anchorId } from '../anchors';
import { oldTalesFilterAttrs } from '../timelineFilter';
import { thumbnailsFor } from '../thumbnails';
import Thumb from './Thumb.astro';
import WatchToggle from './WatchToggle.astro';

interface Props {
  group: OldTalesGroup;
  order: number;
}

const { group, order } = Astro.props;
const orderStr = String(order).padStart(2, '0');
const thumbs = thumbnailsFor(group.title);
---

<div class="node" {...oldTalesFilterAttrs(group)}>
  <div
    class:list={['group', { 'has-thumb': thumbs.length > 0 }]}
    id={anchorId('story', group.title)}
    data-anniv={group.anniversary ? '' : undefined}
  >
    <Thumb title={group.title} />
    <WatchToggle id={anchorId('story', group.title)} title={group.title} />
    <div class="gh">
      <span class="order">{orderStr}</span>{group.title}
    </div>
    <div class="meta-row" style="margin: 4px 0 12px;">
      <span class="badge cat-main">메인</span>
      <span class="badge cat-event">이벤트</span>
      {group.anniversary && <span class="badge anniv">{group.anniversary}</span>}
      <span class="badge req">필수</span>
    </div>
    <div class="gd" set:html={group.description}></div>
    <div class="routes">
      {
        group.routes.map((route) => (
          <div class="route">
            <div class={`rn ${route.best ? 'rn-best' : ''}`}>
              {route.name}
              {route.best && <span class="rn-star">★</span>}
            </div>
            <div class="rp">{route.path}</div>
            <div class="rd" set:html={route.description} />
          </div>
        ))
      }
    </div>
    <div
      class="gd"
      style="margin-top:14px; border-bottom:none; padding-bottom:0;"
      set:html={group.innerNote}
    >
    </div>
  </div>
</div>
