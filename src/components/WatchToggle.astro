---
// 카드 오른쪽 위의 감상 완료 체크. 상태와 저장은 WatchProgress.astro의 스크립트가 맡는다.
import { watchWeight } from '../watched';
interface Props {
  id: string; // 카드 · 묶음 요소 id
  title: string;
}

const { id, title } = Astro.props;
---

<button
  class="watch-toggle"
  type="button"
  aria-pressed="false"
  aria-label={`${title} 감상 완료`}
  title="감상 완료로 표시"
  data-watch={id}
  data-weight={watchWeight(title)}
>
  <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
    <path d="M3.5 8.5l3 3 6-7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
</button>
